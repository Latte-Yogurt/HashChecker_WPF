<Window x:Class="HashChecker.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="关于 HashChecker"
        Width="460" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="BodyText" Grid.Row="0" TextWrapping="Wrap"
                   VerticalAlignment="Center" />

        <Button x:Name="BtnOk" Grid.Row="1" Content="确定" Width="88" Height="28"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                IsDefault="True" IsCancel="True" Click="Ok_Click" />
    </Grid>
</Window>
