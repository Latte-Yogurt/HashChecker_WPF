<Window x:Class="HashChecker.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="比较 SHA256 值"
        Width="620" Height="330"
        MinWidth="560" MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12"
        Loaded="Window_Loaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LblFileCaption" Grid.Row="0" Grid.Column="0"
                   Text="文件：" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBlock x:Name="FileNameText" Grid.Row="0" Grid.Column="1"
                   Margin="0,0,0,8" VerticalAlignment="Center"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="LblCurrentCaption" Grid.Row="1" Grid.Column="0"
                   Text="当前 SHA256 值：" Margin="0,0,8,6" VerticalAlignment="Center" />
        <TextBox x:Name="CurrentHashText" Grid.Row="1" Grid.Column="1"
                 Margin="0,0,0,6" IsReadOnly="True" BorderThickness="0"
                 Background="#F5F5F5" Padding="4,3"
                 FontFamily="Consolas, Courier New" FontSize="12"
                 HorizontalScrollBarVisibility="Auto" />

        <TextBlock x:Name="LblExpectedCaption" Grid.Row="2" Grid.Column="0"
                   Text="保存的 SHA256 值：" Margin="0,0,8,6" VerticalAlignment="Center" />
        <TextBox x:Name="ExpectedHashText" Grid.Row="2" Grid.Column="1"
                 Margin="0,0,0,6" IsReadOnly="True" BorderThickness="0"
                 Background="#F5F5F5" Padding="4,3"
                 FontFamily="Consolas, Courier New" FontSize="12"
                 HorizontalScrollBarVisibility="Auto" />

        <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1"
                Background="#E0E0E0" Margin="0,6,0,10" />

        <TextBlock x:Name="LblInputCaption" Grid.Row="4" Grid.Column="0"
                   Text="要比较的 SHA256 值：" Margin="0,0,8,0"
                   VerticalAlignment="Center" />
        <TextBox x:Name="InputBox" Grid.Row="4" Grid.Column="1"
                 Height="26" Padding="4,3" VerticalContentAlignment="Center"
                 FontFamily="Consolas, Courier New" FontSize="12"
                 TextChanged="InputBox_TextChanged" />

        <TextBlock x:Name="ResultText" Grid.Row="5" Grid.Column="1"
                   Margin="0,8,0,0" TextWrapping="Wrap"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnPaste" Content="粘贴" Width="88" Height="28" Margin="0,0,8,0"
                    Click="Paste_Click" />
            <Button x:Name="BtnOk" Content="确定" Width="88" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click" />
            <Button x:Name="BtnCancel" Content="取消" Width="88" Height="28"
                    IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
