<Window x:Class="HashChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HashChecker"
        mc:Ignorable="d"
        Title="HashChecker"
        Width="1120" Height="620"
        MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragEnter"
        Drop="Window_Drop"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushFailed" Color="#C62828" />
        <SolidColorBrush x:Key="BrushPassed" Color="#1B7F3B" />
        <SolidColorBrush x:Key="BrushMuted" Color="#7A7A7A" />
        <SolidColorBrush x:Key="BrushBarBack" Color="#F3F3F3" />
        <SolidColorBrush x:Key="BrushSeparator" Color="#D9D9D9" />

        <FontFamily x:Key="GlyphFont">Segoe MDL2 Assets</FontFamily>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#FCE9C8" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="#F0C078" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#F5D79B" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="#D8A75A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GlyphFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="FilterButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="5,2,5,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#FCE9C8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#DDEBF7" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="#7EA6C8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Body" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GlyphFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <Style x:Key="FilterText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" x:Name="MainMenu" Padding="0,1,0,1">
            <MenuItem x:Name="MenuFile" Header="文件">
                <MenuItem x:Name="MenuFileSave" Header="保存" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem x:Name="MenuFileSaveItem" Header="保存单项" InputGestureText="Ctrl+Shift+S" Click="SaveItem_Click" />
                <MenuItem x:Name="MenuFileSaveAs" Header="保存到..." Click="SaveAs_Click" />
                <Separator />
                <MenuItem x:Name="MenuFileExit" Header="退出" Click="Exit_Click" />
            </MenuItem>

            <MenuItem x:Name="MenuEdit" Header="编辑">
                <MenuItem x:Name="MenuEditAdd" Header="添加/打开..." InputGestureText="Ins" Click="Add_Click" />
                <MenuItem x:Name="MenuEditRemove" Header="移除" InputGestureText="Del" Click="Remove_Click" />
                <MenuItem x:Name="MenuEditClear" Header="清空" InputGestureText="Ctrl+N" Click="Clear_Click" />
                <Separator />
                <MenuItem x:Name="MenuEditStart" Header="开始" InputGestureText="Enter" Click="Start_Click" />
                <MenuItem x:Name="MenuEditStop" Header="停止" InputGestureText="Esc" Click="Stop_Click" />
                <Separator />
                <MenuItem x:Name="MenuEditCompare" Header="比较哈希值" InputGestureText="F2" Click="Compare_Click" />
                <Separator />
                <MenuItem x:Name="MenuEditCopy" Header="复制哈希值" InputGestureText="Ctrl+C" Click="Copy_Click" />
                <MenuItem x:Name="MenuEditCopyPath" Header="复制路径" Click="CopyPath_Click" />
                <Separator />
                <MenuItem x:Name="MenuEditSelectAll" Header="全部选定" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
            </MenuItem>

            <MenuItem x:Name="MenuView" Header="查看">
                <MenuItem x:Name="MenuViewAll" Header="全部" IsCheckable="True" IsChecked="True" Click="FilterMenu_Click" Tag="All" />
                <Separator />
                <MenuItem x:Name="MenuViewUnavailable" Header="不可用" IsCheckable="True" Click="FilterMenu_Click" Tag="Unavailable" />
                <MenuItem x:Name="MenuViewUnknown" Header="未知" IsCheckable="True" Click="FilterMenu_Click" Tag="Unknown" />
                <MenuItem x:Name="MenuViewLoaded" Header="载入" IsCheckable="True" Click="FilterMenu_Click" Tag="Loaded" />
                <MenuItem x:Name="MenuViewNew" Header="新增" IsCheckable="True" Click="FilterMenu_Click" Tag="New" />
                <MenuItem x:Name="MenuViewFailed" Header="失败" IsCheckable="True" Click="FilterMenu_Click" Tag="Failed" />
                <MenuItem x:Name="MenuViewPassed" Header="通过" IsCheckable="True" Click="FilterMenu_Click" Tag="Passed" />
                <Separator />
                <MenuItem x:Name="MenuViewLocate" Header="定位" InputGestureText="F3" Click="Locate_Click" />
                <MenuItem x:Name="MenuViewProperties" Header="属性" InputGestureText="Alt+Enter" Click="Properties_Click" />
            </MenuItem>

            <MenuItem x:Name="MenuTools" Header="工具">
                <MenuItem x:Name="MenuToolsSelfTest" Header="自验证" Click="SelfTest_Click" />
                <MenuItem x:Name="MenuToolsCalculator" Header="SHA256 值计算器..." Click="Calculator_Click" />
                <Separator />
                <MenuItem x:Name="MenuToolsOptions" Header="选项..." Click="Options_Click" />
            </MenuItem>

            <MenuItem x:Name="MenuHelp" Header="帮助">
                <MenuItem x:Name="MenuHelpAbout" Header="关于 HashChecker..." Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{StaticResource BrushBarBack}"
                BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,1" Padding="2,1,2,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnSave" Style="{StaticResource ToolbarButton}" Click="Save_Click" ToolTip="保存">
                    <StackPanel>
                        <TextBlock Text="&#xE74E;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblSave" Text="保存" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSaveItem" Style="{StaticResource ToolbarButton}" Click="SaveItem_Click" ToolTip="保存单项">
                    <StackPanel>
                        <TextBlock Text="&#xE792;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblSaveItem" Text="保存单项" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSaveAs" Style="{StaticResource ToolbarButton}" Click="SaveAs_Click" ToolTip="保存到">
                    <StackPanel>
                        <TextBlock Text="&#xE792;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblSaveAs" Text="保存到" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BrushSeparator}" Margin="3,4,3,4" />

                <Button x:Name="BtnAdd" Style="{StaticResource ToolbarButton}" Click="Add_Click" ToolTip="添加">
                    <StackPanel>
                        <TextBlock Text="&#xE710;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblAdd" Text="添加" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRemove" Style="{StaticResource ToolbarButton}" Click="Remove_Click" ToolTip="移除">
                    <StackPanel>
                        <TextBlock Text="&#xE74D;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblRemove" Text="移除" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnClear" Style="{StaticResource ToolbarButton}" Click="Clear_Click" ToolTip="清空">
                    <StackPanel>
                        <TextBlock Text="&#xE894;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblClear" Text="清空" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BrushSeparator}" Margin="3,4,3,4" />

                <Button x:Name="BtnStart" Style="{StaticResource ToolbarButton}" Click="Start_Click" ToolTip="开始（Enter）">
                    <StackPanel>
                        <TextBlock Text="&#xE768;" Style="{StaticResource ToolbarGlyph}" Foreground="#1B7F3B" />
                        <TextBlock x:Name="LblStart" Text="开始" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnStop" Style="{StaticResource ToolbarButton}" Click="Stop_Click" ToolTip="停止（Esc）">
                    <StackPanel>
                        <TextBlock Text="&#xE71A;" Style="{StaticResource ToolbarGlyph}" Foreground="#C62828" />
                        <TextBlock x:Name="LblStop" Text="停止" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BrushSeparator}" Margin="3,4,3,4" />

                <StackPanel VerticalAlignment="Center" Margin="2,0,4,0" ToolTip="没有校验记录时使用的算法">
                    <TextBlock x:Name="LblAlgorithm" Text="算法" Style="{StaticResource ToolbarLabel}"
                               HorizontalAlignment="Left" Margin="0,0,0,3" />
                    <ComboBox x:Name="AlgorithmPicker" Width="112" Height="24"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="AlgorithmPicker_SelectionChanged" />
                </StackPanel>

                <Border Width="1" Background="{StaticResource BrushSeparator}" Margin="3,4,3,4" />

                <Button x:Name="BtnCopy" Style="{StaticResource ToolbarButton}" Click="Copy_Click" ToolTip="复制哈希值">
                    <StackPanel>
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblCopy" Text="复制哈希值" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BrushSeparator}" Margin="3,4,3,4" />

                <Button x:Name="BtnLocate" Style="{StaticResource ToolbarButton}" Click="Locate_Click" ToolTip="定位（F3）">
                    <StackPanel>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblLocate" Text="定位" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BrushSeparator}" Margin="3,4,3,4" />

                <Button x:Name="BtnOptions" Style="{StaticResource ToolbarButton}" Click="Options_Click" ToolTip="选项">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblOptions" Text="选项" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSelfTest" Style="{StaticResource ToolbarButton}" Click="SelfTest_Click" ToolTip="自验证">
                    <StackPanel>
                        <TextBlock Text="&#xE8FB;" Style="{StaticResource ToolbarGlyph}" />
                        <TextBlock x:Name="LblSelfTest" Text="自验证" Style="{StaticResource ToolbarLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BrushBarBack}" Padding="2,2,2,2">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="FilterAll" Style="{StaticResource FilterButton}" IsChecked="True" Click="FilterBar_Click" Tag="All">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A9;" Style="{StaticResource FilterGlyph}" />
                        <TextBlock x:Name="LblFilterAll" Text="全部(0)" Style="{StaticResource FilterText}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FilterUnavailable" Style="{StaticResource FilterButton}" Click="FilterBar_Click" Tag="Unavailable">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource FilterGlyph}" Foreground="#D8A200" />
                        <TextBlock x:Name="LblFilterUnavailable" Text="不可用(0)" Style="{StaticResource FilterText}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FilterUnknown" Style="{StaticResource FilterButton}" Click="FilterBar_Click" Tag="Unknown">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9CE;" Style="{StaticResource FilterGlyph}" Foreground="#4A90D9" />
                        <TextBlock x:Name="LblFilterUnknown" Text="未知(0)" Style="{StaticResource FilterText}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FilterLoaded" Style="{StaticResource FilterButton}" Click="FilterBar_Click" Tag="Loaded">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource FilterGlyph}" Foreground="#4A90D9" />
                        <TextBlock x:Name="LblFilterLoaded" Text="载入(0)" Style="{StaticResource FilterText}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FilterNew" Style="{StaticResource FilterButton}" Click="FilterBar_Click" Tag="New">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource FilterGlyph}" Foreground="#4A90D9" />
                        <TextBlock x:Name="LblFilterNew" Text="新增(0)" Style="{StaticResource FilterText}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FilterFailed" Style="{StaticResource FilterButton}" Click="FilterBar_Click" Tag="Failed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" Style="{StaticResource FilterGlyph}" Foreground="#D93025" />
                        <TextBlock x:Name="LblFilterFailed" Text="失败(0)" Style="{StaticResource FilterText}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FilterPassed" Style="{StaticResource FilterButton}" Click="FilterBar_Click" Tag="Passed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE930;" Style="{StaticResource FilterGlyph}" Foreground="#1B7F3B" />
                        <TextBlock x:Name="LblFilterPassed" Text="通过(0)" Style="{StaticResource FilterText}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource BrushSeparator}" />

        <ListView x:Name="ItemList"
                  Grid.Row="4"
                  BorderThickness="0"
                  Background="#FFFFFF"
                  SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  SelectionChanged="ItemList_SelectionChanged"
                  MouseDoubleClick="ItemList_MouseDoubleClick"
                  KeyDown="ItemList_KeyDown">
            <ListView.ContextMenu>
                <ContextMenu x:Name="ListMenu">
                    <MenuItem Header="开始" Click="Start_Click" />
                    <MenuItem Header="比较哈希值" Click="Compare_Click" />
                    <Separator />
                    <MenuItem Header="复制哈希值" Click="Copy_Click" />
                    <MenuItem Header="复制路径" Click="CopyPath_Click" />
                    <Separator />
                    <MenuItem Header="定位" Click="Locate_Click" />
                    <MenuItem Header="属性" Click="Properties_Click" />
                    <Separator />
                    <MenuItem Header="移除" Click="Remove_Click" />
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn x:Name="ColName" Header="名称" Width="165">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{Binding IconBrush}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="ColFolder" Header="所在文件夹" Width="145">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="ColAlgorithm" Header="算法" Width="96">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AlgorithmText}"
                                           ToolTip="{Binding AlgorithmTooltip}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="ColCurrent" Header="当前值" Width="290">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CurrentHashText}"
                                           Foreground="{Binding CurrentHashBrush}"
                                           FontFamily="Consolas, Courier New"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentHashTooltip}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="ColSaved" Header="保存值" Width="290">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExpectedHashText}"
                                           FontFamily="Consolas, Courier New"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ExpectedHashTooltip}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="ColSize" Header="大小" Width="92">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="ColModified" Header="修改日期" Width="142">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ModifiedText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="4"
                   Text="把文件或文件夹拖到这里，或点击工具栏的「添加」按钮。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource BrushMuted}"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />

        <ProgressBar x:Name="MainProgressBar" Grid.Row="5"
                     Minimum="0" Maximum="100" Value="0"
                     Height="10" BorderThickness="0" Background="#E9E9E9"
                     BorderBrush="{StaticResource BrushSeparator}"
                     Foreground="#3E9B4F" />

        <Border Grid.Row="6" Background="{StaticResource BrushBarBack}"
                BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMain" Grid.Column="0" Text="0 个对象"
                           Margin="6,3,6,3" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusRight" Grid.Column="1" Text="就绪"
                           Margin="6,3,8,3" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushMuted}" />
            </Grid>
        </Border>
    </Grid>
</Window>
